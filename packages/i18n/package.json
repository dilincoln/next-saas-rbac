{
  "name": "@saas/i18n",
  "version": "0.0.0",
  "private": true,
  "files": [
    "paraglide/messages.js",
    "types/*.d.ts"
  ],
  "exports": {
    "./messages": {
      "default": "./paraglide/messages.js",
      "types": "./types/messages.d.ts"
    },
    ".": {
      "default": "./paraglide/runtime.js",
      "types": "./types/runtime.d.ts"
    }
  },
  "scripts": {
    "dev": "run-p dev:*",
    "dev:paraglide": "pnpm build --watch",
    "dev:tsc": "tsc --watch",
    "translate:missing": "pnpm dlx @inlang/cli machine translate --project src.inlang",
    "preinstall": "paraglide-js compile --project ./src.inlang --outdir ./paraglide",
    "postinstall": "tsc",
    "build": "paraglide-js compile --project ./src.inlang --outdir ./paraglide"
  },
  "devDependencies": {
    "@inlang/cli": "^2.18.1",
    "@inlang/paraglide-js": "1.11.3",
    "@saas/ts-config": "workspace:*",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.6.3"
  }
}
